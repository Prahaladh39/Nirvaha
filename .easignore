# Ignore node_modules - EAS installs them in the cloud
node_modules/

# Ignore git history
.git/

# Ignore local Expo files and cache
.expo/
.expo-shared/

# Ignore old builds and temporary files
dist/
build/
web-build/
nativant/
*.log

# Ignore local environment files (except for what you specifically want to include)
.env.local
.env.*.local

# Ignore OS-specific files
.DS_Store
Thumbs.db
